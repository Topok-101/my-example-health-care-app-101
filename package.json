{
  "name": "HealthCare",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "react-native start",
    "setup": "yarn install && npx pod-install",
    "test": "jest",
    "open:android-studio": "open -a '/Applications/Android Studio.app'",
    "android:dev": "ENV=development ./envscript.sh && react-native run-android --mode=DevelopmentDebug",
    "android:dev-release": "ENV=development ./envscript.sh && react-native run-android --mode=DevelopmentRelease",
    "android:prod": "ENV=production ./envscript.sh && react-native run-android --mode=ProductionDebug",
    "android:prod-release": "ENV=production ./envscript.sh && react-native run-android --mode=ProductionRelease",
    "ios:dev": "ENV=development ./envscript.sh && react-native run-ios --scheme HealthCareDevDebug --configuration Debug",
    "ios:dev-release": "ENV=development ./envscript.sh && react-native run-ios --scheme HealthCareDev --configuration Release",
    "ios:prod": "ENV=production ./envscript.sh && react-native run-ios --scheme HealthCareDebug --configuration Debug",
    "ios:prod-release": "ENV=production ./envscript.sh && react-native run-ios --scheme HealthCare --configuration Release",
    "sync:theme": "specify sync",
    "pull:theme": "specify pull -C .specifyrc.json",
    "publish:staging:ios:ci": "cd ./ios && fastlane distribute_ci --verbose --env staging",
    "publish:staging:ios:man": "cd ./ios && fastlane distribute_man --env staging && rm HealthCareDev.app.dSYM.zip && rm HealthCareDev.ipa",
    "publish:staging:android": "cd ./android  && ENVFILE=.env.development fastlane distribute --env staging",
    "publish:stg": "ENV=development ./envscript.sh && yarn publish:staging:ios:man && yarn publish:staging:android",
    "prepare": "husky install && USE_FABRIC=1 npx pod-install"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.2.2",
    "@react-native-async-storage/async-storage": "^1.18.1",
    "@react-native-community/checkbox": "^0.5.14",
    "@react-native-community/geolocation": "^3.0.4",
    "@react-native-community/netinfo": "^9.3.10",
    "@react-native-firebase/app": "^17.4.3",
    "@react-native-firebase/auth": "^17.4.3",
    "@react-native-google-signin/google-signin": "^9.0.2",
    "@react-native-masked-view/masked-view": "^0.2.8",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/elements": "^1.3.10",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/stack": "^6.3.8",
    "@shopify/react-native-skia": "^0.1.208",
    "@tanstack/react-query": "^4.28.0",
    "@types/lodash": "^4.14.190",
    "axios": "^1.2.0",
    "dayjs": "^1.11.7",
    "geolib": "^3.3.3",
    "i18n-js": "^4.1.1",
    "jwt-decode": "^3.1.2",
    "lodash": "^4.17.21",
    "lottie-react-native": "^5.1.6",
    "react": "18.2.0",
    "react-native": "0.72.5",
    "react-native-background-timer": "^2.4.1",
    "react-native-camera-kit": "^13.0.0",
    "react-native-config": "^1.4.11",
    "react-native-fast-image": "^8.6.3",
    "react-native-fbsdk-next": "^11.1.0",
    "react-native-gesture-handler": "^2.12.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "^1.7.1",
    "react-native-reanimated": "^3.4.2",
    "react-native-reanimated-carousel": "^3.3.0",
    "react-native-safe-area-context": "^4.4.1",
    "react-native-screens": "^3.18.2",
    "react-native-sha256": "^1.4.9",
    "react-native-shared-element": "^0.8.8",
    "react-native-splash-screen": "^3.3.0",
    "react-navigation-shared-element": "^3.1.3",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.5",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/eslint-config": "^2.0.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@specifyapp/cli": "^1.1.1",
    "@trivago/prettier-plugin-sort-imports": "^4.0.0",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "^26.0.23",
    "@types/react": "^18.0.24",
    "@types/react-native": "^0.72.2",
    "@types/react-native-background-timer": "^2.0.0",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.37.0",
    "@typescript-eslint/parser": "^5.37.0",
    "babel-jest": "^29.2.1",
    "babel-plugin-module-resolver": "^4.1.0",
    "eslint": "^8.19.0",
    "eslint-config-airbnb": "^19.0.4",
    "husky": "^8.0.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.7.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^4.8.4"
  },
  "engines": {
    "node": ">=16"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
